<?xml version="1.0" encoding="utf-8"?>
<!-- The PortaControl server lives on the home network and speaks plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
